<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Modify the res.config.settings form view to include the bank_fees_account_id field -->
    <record id="res_config_settings_view_form_payment_bank_fees" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='o_setting_left_panel']/following-sibling::div" position="inside">
                <div class="row mt8">
                    <label for="bank_fees_account_id" class="col-lg-5 o_light_label"/>
                    <field name="bank_fees_account_id"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>